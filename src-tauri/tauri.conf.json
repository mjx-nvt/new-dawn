{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "New Dawn",
  "version": "0.1.0",
  "identifier": "co.majorisdigital.newdawn",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "New Dawn",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; frame-src asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/workspaces/*/recordings/**",
          "$APPDATA/workspaces/*/exports/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../brands/": "brands/",
      "icons/Assets.car": "Assets.car",
      "resources/models/ggml-silero-v5.1.2.bin": "models/ggml-silero-v5.1.2.bin"
    },
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
