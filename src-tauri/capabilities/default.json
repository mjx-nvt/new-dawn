{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, settings and work item windows",
  "windows": [
    "main",
    "settings",
    "item-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/workspaces/*/files/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "message:*" }, { "url": "mailto:*" }]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
